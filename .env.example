# ============================================================================
# Sales Copilot — Root Environment Variables
# Used by: docker-compose.dev.yml & docker-compose.prod.yml
# Copy this file to .env and fill in your values:  cp .env.example .env
# ============================================================================

# ── Infrastructure (PostgreSQL, Redis, MinIO) ───────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=sales_copilot_dev
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Domain & Networking (Nginx & Services) ──────────────────────────────────
HTTP_PORT=80
APP_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
CORS_ORIGIN=http://localhost:3000

# Webhook Base URL auto-inherits APP_BASE_URL (only set if using a dedicated webhook tunnel):
# WEBHOOK_BASE_URL=https://sales-copilot.kakadev.xyz

# ── Application Secrets & Security ──────────────────────────────────────────
JWT_ACCESS_TOKEN_SECRET=your-jwt-secret-at-least-32-characters-long
CHANNEL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Meta / Facebook Messenger (optional) ─────────────────────────────────────
# FB_APP_ID=
# FB_APP_SECRET=
# FB_VERIFY_TOKEN=

# AI / LLM Keys (optional — required for AI features)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_VERTEX_PROJECT=
# GOOGLE_VERTEX_LOCATION=

# ── Email Service (Resend) ──────────────────────────────────────────────────
# RESEND_API_KEY=re_123456789
# Dùng onboarding@resend.dev khi chưa xác thực custom domain
# RESEND_FROM_EMAIL=Sales Copilot <onboarding@resend.dev> 
