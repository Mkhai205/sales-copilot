# ============================================================================
# Sales Copilot — Root Environment Variables
# Used by: docker-compose.dev.yml & docker-compose.prod.yml
# Copy this file to .env and fill in your values:  cp .env.example .env
# ============================================================================

# ── Infrastructure (docker-compose.dev.yml + docker-compose.prod.yml) ────────

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=sales_copilot_dev
POSTGRES_PORT=5432                    # Host port mapping (dev only)

# Redis
REDIS_PORT=6379                       # Host port mapping (dev only)

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
MINIO_PORT=9000                       # Host port mapping (dev only)
MINIO_CONSOLE_PORT=9001               # MinIO Console UI

# ── Application Secrets (docker-compose.prod.yml only) ───────────────────────

# JWT — CHANGE THESE IN PRODUCTION!
JWT_ACCESS_TOKEN_SECRET=your-jwt-secret-at-least-32-characters-long
CHANNEL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Meta / Facebook (optional — required for Messenger channel)
# FB_APP_ID=
# FB_APP_SECRET=
# FB_VERIFY_TOKEN=

# AI / LLM Keys (optional — required for AI features)
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ── Domain & Networking (docker-compose.prod.yml only) ───────────────────────

# Nginx exposed port (default: 80)
HTTP_PORT=80

# Public-facing URLs — update when deploying with a domain
CORS_ORIGIN=http://localhost
WEBHOOK_BASE_URL=http://localhost
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000


# ── Tunnel Mode (uncomment when using --profile tunnel) ──────────────────────
# Note: In single-domain setup via Nginx, the frontend automatically connects to
# same-origin (/api/v1 and window.location.origin). Only backend URLs are needed:

# CORS_ORIGIN=https://sales-copilot.kakadev.xyz,http://localhost:3000
# WEBHOOK_BASE_URL=https://sales-copilot.kakadev.xyz
# STORAGE_PUBLIC_ENDPOINT=https://storage-sales-copilot.kakadev.xyz
