# ==============================================================================
# Sales Copilot Platform - Local Development Environment Variables
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
WEB_PORT=3001
CORS_ORIGIN=http://localhost:3001

# PostgreSQL Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=sales_copilot_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# MinIO (S3 Object Storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=miniopassword123
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=localhost
MINIO_USE_SSL=false
MINIO_BUCKET_ATTACHMENTS=sales-copilot-attachments
MINIO_BUCKET_MEDIA=sales-copilot-media
MINIO_BUCKET_AVATARS=sales-copilot-avatars

# Authentication & JWT
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_32_chars_min
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_32_chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AI Providers (LLM Gateway)
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=
GEMINI_API_KEY=AIza...

# External Channel Integrations (Optional for local dev)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_VERIFY_TOKEN=
ZALO_APP_ID=
ZALO_APP_SECRET=
TELEGRAM_BOT_TOKEN=
