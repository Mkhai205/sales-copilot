# ============================================================================
# Sales Copilot — Frontend (Next.js) Environment Variables
# Used by: pnpm serve:web (local development only)
# Copy this file to .env:  cp .env.example .env
# ============================================================================

# ── API Configuration ────────────────────────────────────────────────────────
# Backend API base URL (used for SSR fetch calls and client-side fallback)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── WebSocket Configuration (optional) ───────────────────────────────────────
# Derived from NEXT_PUBLIC_API_URL if not set
# NEXT_PUBLIC_WS_URL=http://localhost:8000

# ── Internal API Configuration (Docker only) ─────────────────────────────────
# Direct container-to-container communication inside Docker network (SSR / Server Actions)
# INTERNAL_API_URL=http://server:8000/api/v1

# ── Cookie Domain (optional) ────────────────────────────────────────────────
# Only needed for cross-subdomain auth (auto-detected from hostname if not set)
# When using single domain via nginx, this is NOT needed
# COOKIE_DOMAIN=.kakadev.xyz

# ── Notes ────────────────────────────────────────────────────────────────────
# In production / tunnel mode (behind nginx reverse proxy):
#   - Browser API calls use relative URL '/api/v1' automatically (same-origin)
#   - WebSocket connects to window.location.origin automatically (same-origin)
#   - Server-side calls use INTERNAL_API_URL (http://server:8000/api/v1) for zero-latency communication
