{
  "name": "web",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/web/src",
  "projectType": "application",
  "targets": {
    "build": {
      "configurations": {
        "development": {}
      }
    },
    "serve": {
      "defaultConfiguration": "development",
      "options": {
        "port": 3000
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/web/tsconfig.json --noEmit"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -r @swc-node/register -r tsconfig-paths/register --test apps/web/src/**/__tests__/*.spec.ts"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint apps/web"
      }
    }
  }
}
