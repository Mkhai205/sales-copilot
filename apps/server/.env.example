# --- Environment Configuration ---
NODE_ENV=development
CORS_ORIGIN='http://localhost:3000'

# --- JWT Configuration ---
JWT_ACCESS_TOKEN_SECRET=
JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800

# --- Database Configuration ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/sales_copilot_dev?schema=public

# --- Redis Configuration ---
REDIS_URL=redis://localhost:6379

# --- Storage Configuration ---
STORAGE_ACCESS_KEY="minioadmin"
STORAGE_SECRET_KEY="miniopassword123"
STORAGE_ENDPOINT=localhost:9000
STORAGE_PUBLIC_ENDPOINT=localhost:9000
STORAGE_PRESIGNED_URL_EXPIRES_IN_SECONDS=900
STORAGE_BUCKETS="sales-copilot"

# --- Security & Encryption Configuration ---
# 32-byte hex key (64 hex characters) for AES-256-GCM Channel credential encryption
CHANNEL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Public Domain (webhook callback, OAuth redirect) ---
# WEBHOOK_BASE_URL=https://api.your-domain.com

# --- Meta / Facebook Platform App (for OAuth 1-click) ---
# Create a Meta App at https://developers.facebook.com
# FB_APP_ID=
# FB_APP_SECRET=
# FB_VERIFY_TOKEN=