# ============================================================================
# Sales Copilot — Backend (NestJS) Environment Variables
# Used by: pnpm serve:server (local development only)
# Copy this file to .env:  cp .env.example .env
# ============================================================================

# ── General ──────────────────────────────────────────────────────────────────
NODE_ENV=development
# PORT=8000
# LOG_LEVEL=debug

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# NOTE: Wildcard '*' is NOT allowed when credentials: true
CORS_ORIGIN=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/sales_copilot_dev?schema=public
# DATABASE_POOL_MAX=10
# DATABASE_POOL_MIN=2
# DATABASE_POOL_IDLE_TIMEOUT_MS=10000
# DATABASE_POOL_CONNECTION_TIMEOUT_MS=5000

# ── Authentication ───────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_SECRET=your-jwt-secret-at-least-32-characters-long
# JWT_ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
# REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Storage (MinIO / S3) ────────────────────────────────────────────────────
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=miniopassword123
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
# STORAGE_REGION=us-east-1
# STORAGE_BUCKETS=sales-copilot
# STORAGE_PRESIGNED_URL_EXPIRES_IN_SECONDS=900

# ── Security ─────────────────────────────────────────────────────────────────
# AES-256-GCM key for channel credential encryption (64 hex chars = 32 bytes)
CHANNEL_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Webhooks (optional — required for external channel callbacks) ────────────
# Public URL where external services (Facebook, Telegram) can reach your server
# WEBHOOK_BASE_URL=https://sales-copilot.kakadev.xyz

# ── Meta / Facebook (optional — required for Messenger channel) ──────────────
# FB_APP_ID=
# FB_APP_SECRET=
# FB_VERIFY_TOKEN=

# ── AI / LLM (optional — required for AI features) ──────────────────────────
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# ── Tunnel Mode (uncomment when using Cloudflare Tunnel) ─────────────────────
# CORS_ORIGIN=https://sales-copilot.kakadev.xyz,http://localhost:3000
# WEBHOOK_BASE_URL=https://sales-copilot.kakadev.xyz
# STORAGE_PUBLIC_ENDPOINT=https://storage-sales-copilot.kakadev.xyz