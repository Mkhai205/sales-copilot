{
  "name": "@sales-copilot/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate": "npx prisma generate --schema=./prisma/schema.prisma",
    "db:migrate:dev": "npx prisma migrate dev --schema=./prisma/schema.prisma",
    "db:migrate:deploy": "npx prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:seed": "npx ts-node ./prisma/seed.ts",
    "db:studio": "npx prisma studio --schema=./prisma/schema.prisma",
    "db:push": "npx prisma db push --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sales-copilot/shared-contracts": "workspace:*",
    "argon2": "^0.41.1",
    "bullmq": "^6.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.13.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/ioredis": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.11",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2"
  }
}
