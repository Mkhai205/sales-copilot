{
  "name": "@sales-copilot/source",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "build": "nx run-many -t build",
    "build:server": "nx run server:build",
    "build:web": "nx run web:build",
    "serve:server": "nx serve server",
    "serve:web": "nx serve web",
    "typecheck": "nx run-many -t typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @sales-copilot/server db:generate",
    "db:migrate:dev": "pnpm --filter @sales-copilot/server db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @sales-copilot/server db:migrate:deploy",
    "db:seed": "pnpm --filter @sales-copilot/server db:seed",
    "db:reset": "pnpm --filter @sales-copilot/server db:reset",
    "db:studio": "pnpm --filter @sales-copilot/server db:studio",
    "db:push": "pnpm --filter @sales-copilot/server db:push"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nx/eslint": "23.1.1",
    "@nx/js": "23.1.1",
    "@nx/nest": "23.1.1",
    "@nx/next": "23.1.1",
    "@nx/node": "23.1.1",
    "@nx/react": "23.1.1",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@types/node": "^24.0.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "nx": "23.1.1",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
