{
  "compilerOptions": {
    "paths": {
      "@sales-copilot/shared-contracts": ["./packages/shared-contracts/src/index.ts"],
      "@sales-copilot/shared-contracts/*": ["./packages/shared-contracts/src/*"]
    },
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "types": ["node"]
  },
  "exclude": ["node_modules", ".docs", "docs", ".agents", "dist", ".next"]
}
