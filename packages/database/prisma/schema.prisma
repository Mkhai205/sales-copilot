datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum PlatformRole {
  SUPER_ADMIN
  USER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  AGENT
  VIEWER
}

enum BillingPlanType {
  FREE
  STANDARD
  ENTERPRISE
}

enum ChannelType {
  FACEBOOK_MESSENGER
  ZALO
  TELEGRAM
  EMAIL
  WEB_CHAT
}

enum ConversationStatus {
  OPEN
  RESOLVED
  PENDING
  SNOOZED
}

enum ConversationPriority {
  URGENT
  HIGH
  MEDIUM
  LOW
}

enum MessageType {
  INCOMING
  OUTGOING
  ACTIVITY
  TEMPLATE
}

enum MessageContentType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
}

enum DeliveryStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum SenderType {
  CONTACT
  USER
  SYSTEM
}

enum WebhookDeliveryStatus {
  PENDING
  DELIVERED
  FAILED
  RETRYING
  EXHAUSTED
}

enum FileType {
  IMAGE
  AUDIO
  VIDEO
  FILE
}

model User {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  avatarUrl    String?
  role         PlatformRole @default(USER)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  workspaceMembers      WorkspaceMember[]
  teamMembers           TeamMember[]
  inboxMembers          InboxMember[]
  assignedConversations Conversation[]    @relation("UserAssignedConversations")
  auditLogs             AuditLog[]

  @@map("users")
}

model Workspace {
  id              String          @id @default(uuid())
  name            String
  slug            String          @unique
  billingPlan     BillingPlanType @default(FREE)
  timezone        String          @default("Asia/Ho_Chi_Minh")
  defaultLanguage String          @default("vi")
  settings        Json            @default("{}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  members              WorkspaceMember[]
  teams                Team[]
  inboxes              Inbox[]
  channels             Channel[]
  contacts             Contact[]
  channelIdentities    ChannelIdentity[]
  conversations        Conversation[]
  messages             Message[]
  cannedResponses      CannedResponse[]
  labels               Label[]
  automationRules      AutomationRule[]
  webhookSubscriptions WebhookSubscription[]
  auditLogs            AuditLog[]

  @@map("workspaces")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(AGENT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Team {
  id          String   @id @default(uuid())
  workspaceId String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  conversations Conversation[]

  @@unique([workspaceId, name])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Contact {
  id                   String   @id @default(uuid())
  workspaceId          String
  name                 String
  email                String?
  phoneNumber          String?
  avatarUrl            String?
  identifier           String?
  customAttributes     Json     @default("{}")
  additionalAttributes Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  identities    ChannelIdentity[]
  conversations Conversation[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId, email])
  @@index([workspaceId, phoneNumber])
  @@index([workspaceId, createdAt])
  @@map("contacts")
}

model ChannelIdentity {
  id                String      @id @default(uuid())
  contactId         String
  workspaceId       String
  channelId         String
  externalContactId String
  username          String?
  metadata          Json        @default("{}")
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  contact       Contact        @relation(fields: [contactId], references: [id], onDelete: Cascade)
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([channelId, externalContactId])
  @@index([contactId])
  @@index([workspaceId])
  @@map("channel_identities")
}

model Inbox {
  id                      String   @id @default(uuid())
  workspaceId             String
  name                    String
  avatarUrl               String?
  settings                Json     @default("{}")
  isAutoAssignmentEnabled Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channel       Channel?
  members       InboxMember[]
  conversations Conversation[]

  @@index([workspaceId])
  @@map("inboxes")
}

model InboxMember {
  id        String   @id @default(uuid())
  inboxId   String
  userId    String
  createdAt DateTime @default(now())

  inbox Inbox @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([inboxId, userId])
  @@map("inbox_members")
}

model Channel {
  id                String      @id @default(uuid())
  workspaceId       String
  inboxId           String      @unique
  channelType       ChannelType
  providerAccountId String?
  credentials       Json        @default("{}")
  settings          Json        @default("{}")
  isConnected       Boolean     @default(false)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inbox      Inbox             @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  identities ChannelIdentity[]
  events     ChannelEvent[]

  @@unique([workspaceId, channelType, providerAccountId])
  @@index([workspaceId, channelType])
  @@map("channels")
}

model ChannelEvent {
  id              String    @id @default(uuid())
  channelId       String
  externalEventId String
  eventType       String
  payload         Json
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, externalEventId])
  @@index([channelId, createdAt])
  @@map("channel_events")
}

model Conversation {
  id                  String               @id @default(uuid())
  displayId           Int                  @default(autoincrement())
  workspaceId         String
  inboxId             String
  contactId           String
  channelIdentityId   String?
  assigneeId          String?
  teamId              String?
  status              ConversationStatus   @default(OPEN)
  priority            ConversationPriority @default(MEDIUM)
  snoozedUntil        DateTime?
  waitingSince        DateTime?
  firstReplyCreatedAt DateTime?
  lastActivityAt      DateTime             @default(now())
  unreadMessagesCount Int                  @default(0)
  customAttributes    Json                 @default("{}")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  workspace       Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inbox           Inbox               @relation(fields: [inboxId], references: [id], onDelete: Cascade)
  contact         Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channelIdentity ChannelIdentity?    @relation(fields: [channelIdentityId], references: [id], onDelete: SetNull)
  assignee        User?               @relation("UserAssignedConversations", fields: [assigneeId], references: [id], onDelete: SetNull)
  team            Team?               @relation(fields: [teamId], references: [id], onDelete: SetNull)
  messages        Message[]
  labels          ConversationLabel[]

  @@unique([workspaceId, displayId])
  @@index([workspaceId, status])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, contactId])
  @@index([workspaceId, inboxId])
  @@index([workspaceId, lastActivityAt])
  @@map("conversations")
}

model ConversationLabel {
  conversationId String
  labelId        String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  label        Label        @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([conversationId, labelId])
  @@index([labelId])
  @@map("conversation_labels")
}

model Message {
  id             String             @id @default(uuid())
  conversationId String
  workspaceId    String
  senderType     SenderType
  senderId       String?
  messageType    MessageType        @default(INCOMING)
  contentType    MessageContentType @default(TEXT)
  content        String?
  isPrivate      Boolean            @default(false)
  deliveryStatus DeliveryStatus     @default(SENT)
  externalId     String?
  metadata       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  attachments  Attachment[]

  @@unique([conversationId, externalId])
  @@index([conversationId, createdAt])
  @@index([workspaceId, externalId])
  @@map("messages")
}

model Attachment {
  id          String   @id @default(uuid())
  messageId   String
  fileType    FileType
  fileName    String
  fileSize    Int
  storagePath String
  contentType String
  createdAt   DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("attachments")
}

model CannedResponse {
  id          String   @id @default(uuid())
  workspaceId String
  shortCode   String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, shortCode])
  @@index([workspaceId])
  @@map("canned_responses")
}

model Label {
  id            String   @id @default(uuid())
  workspaceId   String
  title         String
  description   String?
  color         String   @default("#2563eb")
  showOnSidebar Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  conversations ConversationLabel[]

  @@unique([workspaceId, title])
  @@index([workspaceId])
  @@map("labels")
}

model AutomationRule {
  id           String   @id @default(uuid())
  workspaceId  String
  name         String
  description  String?
  eventTrigger String
  conditions   Json     @default("[]")
  actions      Json     @default("[]")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, isActive])
  @@map("automation_rules")
}

model WebhookSubscription {
  id            String   @id @default(uuid())
  workspaceId   String
  url           String
  secretKey     String?
  subscriptions Json     @default("[]")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId, isActive])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String                @id @default(uuid())
  subscriptionId String
  eventId        String
  eventType      String
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attemptCount   Int                   @default(0)
  responseStatus Int?
  responseBody   String?
  lastAttemptAt  DateTime?
  nextRetryAt    DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([subscriptionId, eventId])
  @@index([subscriptionId, createdAt])
  @@map("webhook_deliveries")
}

model AuditLog {
  id           String   @id @default(uuid())
  workspaceId  String?
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  payload      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  user      User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}
